CODEX_WEB_PORT=3290
# An executable file, not a shell command. Omit to discover codex on PATH.
# CODEX_WEB_CODEX_BIN=/absolute/path/to/codex
# CODEX_WEB_DATA_DIR=/absolute/path/to/private-data
# CODEX_WEB_WORKSPACE=/absolute/path/to/workspace
# Set only when using an HTTPS reverse proxy.
# CODEX_WEB_PUBLIC_ORIGIN=https://example.com:8443
